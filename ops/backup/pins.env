# Download pins for ops/backup: the one definition of every shellcheck, restic and cloudflared version and hash.
# Literal KEY=VALUE lines, read by read_pins in fetch-pinned.sh and install-backup.sh, never sourced.
# Hashes are of the release archives (shellcheck: koalaman/shellcheck v0.11.0 linux tar.xz;
# restic: the v0.18.1 release SHA256SUMS bz2 archives).
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_AMD64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_ARM64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
RESTIC_VERSION=0.18.1
RESTIC_SHA256_AMD64=680838f19d67151adba227e1570cdd8af12c19cf1735783ed1ba928bc41f363d
RESTIC_SHA256_ARM64=87f53fddde38764095e9c058a3b31834052c37e5826d2acf34e18923c006bd45
# cloudflared (cloudflare/cloudflared release 2026.10.7, published 2026-10-30): the raw linux-amd64 release binary,
# used by .github/workflows/notifs-ops-key.yml (ubuntu-latest, amd64 only, so there is no arm64 pin). The hash was computed
# over the downloaded asset and matches the digest GitHub reports for it.
CLOUDFLARED_VERSION=2026.10.7
CLOUDFLARED_SHA256_AMD64=1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872
